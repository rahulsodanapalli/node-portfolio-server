# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (do not commit production secrets to Git!)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<db_cluster>.mongodb.net/<db_name>?retryWrites=true&w=majority

# Authentication Secrets
# Use a long, complex, random string for JWT signing
JWT_SECRET=your_super_secret_jwt_sign_key_minimum_32_chars

# Portfolio Administrative Panel Login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_secure_password_on_production

# CORS Security Allowed Origins (Comma-separated list of frontends)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourportfolio.vercel.app

# SMTP Mail Server Configuration (For dispatching contact briefs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address@gmail.com
# Use an App Password if using Gmail, do not use your primary password
SMTP_PASS=your_gmail_app_specific_password

# Email Intake Configuration (Target address to receive portfolio briefs)
RECEIVER_EMAIL=your_email_address@gmail.com
